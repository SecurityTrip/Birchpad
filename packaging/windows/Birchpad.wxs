<!--
  Per-machine MSI for enterprise deployment (WiX Toolset v4+). Built by
  .github/workflows/release.yml for stable releases; to build it manually:
    wix build packaging/windows/Birchpad.wxs -arch x64 -d Version=0.1.1 -d BinDir=target/release -d IconFile=packaging/icons/birchpad.ico -o packaging/out/birchpad-x64.msi

  UpgradeCode must never change: it is how Windows Installer recognizes newer versions of Birchpad.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Birchpad"
    Manufacturer="The Birchpad Contributors"
    Version="$(var.Version)"
    UpgradeCode="A1F35DF8-07F9-400E-92E7-E761EC9BAE37"
    Scope="perMachine"
    Compressed="yes">

    <!-- Subject and Author: the code signing configuration checks them
         (packaging/windows/signing/installers.xml). -->
    <SummaryInformation Description="Birchpad" Manufacturer="The Birchpad Contributors" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The icon of Installed apps and of the Start menu shortcut. -->
    <Icon Id="birchpad.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="birchpad.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Birchpad" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Birchpad" Level="1">
      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.BinDir)\birchpad.exe" KeyPath="yes">
          <Shortcut Name="Birchpad" Directory="ProgramMenuFolder" Advertise="yes"
                    Icon="birchpad.ico" WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>
    </Feature>
  </Package>
</Wix>
