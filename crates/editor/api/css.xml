<?xml version="1.0" encoding="UTF-8"?>
<!-- Birchpad's API file for this language (ADR 0031), written for Birchpad and
     licensed as Birchpad is. A file of the same name in the autoCompletion folder next to
     the settings takes its place. -->
<NotepadPlus>
  <AutoComplete language="css">
    <Environment ignoreCase="yes" startFunc="(" stopFunc=")" paramSeparator="," />
    <KeyWord name="absolute" />
    <KeyWord name="align-items" />
    <KeyWord name="align-self" />
    <KeyWord name="animation" />
    <KeyWord name="auto" />
    <KeyWord name="background" />
    <KeyWord name="background-color" />
    <KeyWord name="background-image" />
    <KeyWord name="block" />
    <KeyWord name="bold" />
    <KeyWord name="border" />
    <KeyWord name="border-bottom" />
    <KeyWord name="border-color" />
    <KeyWord name="border-left" />
    <KeyWord name="border-radius" />
    <KeyWord name="border-right" />
    <KeyWord name="border-top" />
    <KeyWord name="bottom" />
    <KeyWord name="box-shadow" />
    <KeyWord name="box-sizing" />
    <KeyWord name="calc" func="yes">
      <Overload retVal="&lt;length&gt;">
        <Param name="expression" />
      </Overload>
    </KeyWord>
    <KeyWord name="center" />
    <KeyWord name="clamp" func="yes">
      <Overload retVal="&lt;length&gt;">
        <Param name="minimum" />
        <Param name="preferred" />
        <Param name="maximum" />
      </Overload>
    </KeyWord>
    <KeyWord name="color" />
    <KeyWord name="column" />
    <KeyWord name="column-gap" />
    <KeyWord name="content" />
    <KeyWord name="cursor" />
    <KeyWord name="display" />
    <KeyWord name="fixed" />
