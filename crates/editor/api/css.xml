      <Overload retVal="&lt;track&gt;">
        <Param name="count" />
        <Param name="tracks" />
      </Overload>
    </KeyWord>
    <KeyWord name="rgb" func="yes">
      <Overload retVal="&lt;color&gt;">
        <Param name="red" />
        <Param name="green" />
        <Param name="blue" />
        <Param name="/ alpha?" />
      </Overload>
    </KeyWord>
    <KeyWord name="rgba" func="yes">
      <Overload retVal="&lt;color&gt;">
        <Param name="red" />
        <Param name="green" />
        <Param name="blue" />
        <Param name="alpha" />
      </Overload>
    </KeyWord>
    <KeyWord name="right" />
    <KeyWord name="rotate" func="yes">
      <Overload retVal="&lt;transform&gt;">
        <Param name="angle" />
      </Overload>
    </KeyWord>
    <KeyWord name="row" />
    <KeyWord name="row-gap" />
    <KeyWord name="scale" func="yes">
      <Overload retVal="&lt;transform&gt;">
        <Param name="x" />
        <Param name="y?" />
      </Overload>
    </KeyWord>
    <KeyWord name="solid" />
    <KeyWord name="space-between" />
    <KeyWord name="sticky" />
