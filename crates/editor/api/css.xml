    <KeyWord name="transition" />
    <KeyWord name="translate" func="yes">
      <Overload retVal="&lt;transform&gt;">
        <Param name="x" />
        <Param name="y?" />
      </Overload>
    </KeyWord>
    <KeyWord name="transparent" />
    <KeyWord name="unset" />
    <KeyWord name="url" func="yes">
      <Overload retVal="&lt;image&gt;">
        <Param name="address" />
      </Overload>
    </KeyWord>
    <KeyWord name="user-select" />
    <KeyWord name="var" func="yes">
      <Overload retVal="value">
        <Param name="--name" />
        <Param name="fallback?" />
      </Overload>
    </KeyWord>
    <KeyWord name="vertical-align" />
    <KeyWord name="visibility" />
    <KeyWord name="white-space" />
    <KeyWord name="width" />
    <KeyWord name="word-break" />
    <KeyWord name="z-index" />
  </AutoComplete>
</NotepadPlus>
