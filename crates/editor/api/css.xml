    <KeyWord name="flex-basis" />
    <KeyWord name="flex-direction" />
    <KeyWord name="flex-end" />
    <KeyWord name="flex-grow" />
    <KeyWord name="flex-shrink" />
    <KeyWord name="flex-start" />
    <KeyWord name="flex-wrap" />
    <KeyWord name="float" />
    <KeyWord name="font" />
    <KeyWord name="font-family" />
    <KeyWord name="font-size" />
    <KeyWord name="font-style" />
    <KeyWord name="font-weight" />
    <KeyWord name="gap" />
    <KeyWord name="grid" />
    <KeyWord name="grid-area" />
    <KeyWord name="grid-column" />
    <KeyWord name="grid-row" />
    <KeyWord name="grid-template-areas" />
    <KeyWord name="grid-template-columns" />
    <KeyWord name="grid-template-rows" />
    <KeyWord name="height" />
    <KeyWord name="hidden" />
    <KeyWord name="hsl" func="yes">
      <Overload retVal="&lt;color&gt;">
        <Param name="hue" />
        <Param name="saturation" />
        <Param name="lightness" />
        <Param name="/ alpha?" />
      </Overload>
    </KeyWord>
    <KeyWord name="important" />
    <KeyWord name="inherit" />
    <KeyWord name="initial" />
    <KeyWord name="inline" />
    <KeyWord name="inline-block" />
    <KeyWord name="justify-content" />
    <KeyWord name="justify-items" />
    <KeyWord name="left" />
    <KeyWord name="letter-spacing" />
    <KeyWord name="line-height" />
    <KeyWord name="linear-gradient" func="yes">
      <Overload retVal="&lt;image&gt;">
        <Param name="direction?" />
        <Param name="color-stop" />
        <Param name="..." />
      </Overload>
    </KeyWord>
    <KeyWord name="list-style" />
    <KeyWord name="margin" />
    <KeyWord name="margin-bottom" />
    <KeyWord name="margin-left" />
    <KeyWord name="margin-right" />
    <KeyWord name="margin-top" />
    <KeyWord name="max-height" />
    <KeyWord name="max-width" />
    <KeyWord name="min-height" />
    <KeyWord name="min-width" />
    <KeyWord name="minmax" func="yes">
      <Overload retVal="&lt;track&gt;">
        <Param name="min" />
        <Param name="max" />
      </Overload>
    </KeyWord>
    <KeyWord name="none" />
    <KeyWord name="nowrap" />
    <KeyWord name="object-fit" />
    <KeyWord name="opacity" />
    <KeyWord name="outline" />
    <KeyWord name="overflow" />
    <KeyWord name="overflow-x" />
    <KeyWord name="overflow-y" />
    <KeyWord name="padding" />
    <KeyWord name="padding-bottom" />
    <KeyWord name="padding-left" />
    <KeyWord name="padding-right" />
    <KeyWord name="padding-top" />
    <KeyWord name="pointer-events" />
    <KeyWord name="position" />
    <KeyWord name="relative" />
