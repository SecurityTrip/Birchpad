# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Test fixtures must stay byte-for-byte as committed: an editor is tested
# on exact encodings, BOMs and line endings.
**/tests/fixtures/** -text -diff
# Fuzzing seeds are inputs byte for byte, like fixtures.
fuzz/seeds/** -text -diff
# Highlight samples are snapshot-tested byte for byte, whatever their extension. They are
# not code of the project: GitHub (its language statistics, CodeQL) does not count them.
**/tests/samples/** -text linguist-detectable=false

*.png binary
*.ico binary
*.icns binary
*.ttf binary

# Built plugins for the tests.
*.wasm binary

# The parser tree-sitter generates from grammar.js: not code to review line by line.
crates/tree-sitter-plantuml/src/parser.c linguist-generated
crates/tree-sitter-plantuml/src/grammar.json linguist-generated
crates/tree-sitter-plantuml/src/node-types.json linguist-generated
crates/tree-sitter-plantuml/src/tree_sitter/*.h linguist-generated
